{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moneyball FM27",
  "version": "0.0.1",
  "identifier": "app.moneyballfm27",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moneyball FM27",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": true,
        "backgroundColor": "#060e1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "licenseFile": "../../LICENSE",
    "resources": { "../../LICENSE": "LICENSE", "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
